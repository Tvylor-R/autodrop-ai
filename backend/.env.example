# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/autodrop_ai

# JWT Authentication
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Shopify OAuth
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_REDIRECT_URI=http://localhost:8000/shopify/callback

# Frontend (where Shopify OAuth returns the user after success)
FRONTEND_URL=http://localhost:3000

# OpenAI (for AI features)
OPENAI_API_KEY=your-openai-api-key

# Celery / background workers
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AutoDrop AI <no-reply@autodrop.ai>
